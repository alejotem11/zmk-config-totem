//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define SYM  1
#define NAV  2
#define NUM  3
#define SYS  4
#define FN   5
#define BT   6

/ {
    combos {
        compatible = "zmk,combos";

        combo_excl {
            bindings = <&kp RA(NUMBER_1)>;
            key-positions = <23 24>;
            layers = <SYM>;
        };

        combo_qmark {
            bindings = <&kp RA(RS(FSLH))>;
            key-positions = <27 28>;
            layers = <SYM>;
        };

        combo_enie {
            bindings = <&macro_enie>;
            key-positions = <19 35>;
            layers = <BASE>;
        };

        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <13 16>;
            layers = <BASE>;
        };

        combo_num {
            bindings = <&mo NUM>;
            key-positions = <23 24>;
            layers = <BASE>;
        };

        combo_mhint {
            bindings = <&kp LA(LG(X))>;
            key-positions = <34 35>;
        };

        combo_mnormal {
            bindings = <&kp LA(LG(C))>;
            key-positions = <34 36>;
        };

        combo_mgrid {
            bindings = <&kp LA(LG(G))>;
            key-positions = <34 37>;
        };

        combo_bt {
            bindings = <&mo BT>;
            key-positions = <22 23 24>;
            layers = <BASE>;
        };
    };

    behaviors {
        hrm_l: hrm_l {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <200>;
            hold-trigger-key-positions = <5 6 7 8 9 31 19 30 29 18 17 28 16 27 15 26 37 36 35 34 33 32 10 11 12 13>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
        };

        hrm_r: hrm_r {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 14 20 21 22 23 24 25 32 33 34 35 36 37 10 11 12 13 16 17 18 19>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
        };

        thumb_hold_tap: thumb_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_HOLD_TAP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    macros {
        macro_enie: macro_enie {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(N) &kp N>;
            label = "MACRO_ENIE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
               &kp Q          &kp W          &kp E           &kp R            &kp T                          &kp Y      &kp U           &kp I                     &kp O          &kp P
               &hrm_l LGUI A  &hrm_l LALT S  &hrm_l LCTRL D  &hrm_l LSHIFT F  &kp G                          &kp H      &hrm_r LSHFT J  &hrm_r LCTRL K            &hrm_r LALT L  &hrm_r LGUI SEMICOLON
&kp LG(SPACE)  &kp Z          &kp X          &kp C           &lt SYM V        &kp B                          &kp N      &lt SYM M       &kp COMMA                 &kp DOT        &kp SLASH              &kp RA(E)
                                             &mo SYS         &kp TAB          &thumb_hold_tap NAV BACKSPACE  &kp SPACE  &kp RETURN      &thumb_hold_tap FN DELETE
            >;
        };

        sym {
            bindings = <
              &kp EXCL        &kp DOUBLE_QUOTES  &kp HASH        &kp SQT               &kp QMARK      &kp SLASH   &kp GRAVE              &kp ASTERISK     &kp AT_SIGN        &kp TILDE
              &kp LESS_THAN   &kp LEFT_BRACKET   &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp CARET      &kp DOLLAR  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp GREATER_THAN
&kp CAPSLOCK  &kp UNDERSCORE  &kp AMPERSAND      &kp MINUS       &kp COLON             &kp PERCENT    &kp EQUAL   &kp BACKSLASH          &kp PLUS         &kp PIPE           &kp LS(RA(N2))    &none
                                                     &none           &none                 &none          &none       &none                  &none
            >;
        };

        nav {
            bindings = <
       &none  &none  &none  &none  &none    &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &kp INS
       &none  &none  &none  &none  &none    &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT  &none
&none  &none  &none  &none  &none  &none    &none     &none          &none        &none      &none    &none
                     &none  &none  &none    &none     &none          &none
            >;
        };

        num {
            bindings = <
       &none   &none   &none   &none   &none    &kp KP_MULTIPLY  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_DIVIDE
       &trans  &trans  &trans  &trans  &none    &kp KP_PLUS      &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_SUBTRACT
&none  &none   &none   &none   &none   &none    &kp KP_EQUAL     &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &none            &none
                       &none   &none   &none    &kp KP_N0        &kp KP_DOT       &none
            >;
        };

        sys {
            bindings = <
       &none  &none  &none  &none  &none    &none                     &kp C_PREV            &kp C_NEXT            &kp C_PLAY_PAUSE  &none
       &none  &none  &none  &none  &none    &kp LS(LC(LG(NUMBER_4)))  &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &kp K_MUTE        &none
&none  &none  &none  &none  &none  &none    &kp LS(LC(LG(NUMBER_3)))  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none             &none  &none
                     &none  &none  &none    &none                     &none                 &none
            >;
        };

        fn {
            bindings = <
       &kp F1   &kp F2   &kp F3   &kp F4   &kp F5     &none  &none  &none  &none  &none
       &kp F6   &kp F7   &kp F8   &kp F9   &kp F10    &none  &none  &none  &none  &none
&none  &kp F11  &kp F12  &kp F13  &kp F14  &kp F15    &none  &none  &none  &none  &none  &none
                         &none    &none    &none      &none  &none  &none
            >;
        };

        bt {
            bindings = <
       &none  &none  &none  &none  &none    &none         &none         &none         &none         &none
       &none  &none  &none  &none  &none    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none  &none  &none  &none  &none  &none    &none         &none         &none         &none         &none         &bt BT_CLR_ALL
                     &none  &none  &none    &none         &none         &none
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
