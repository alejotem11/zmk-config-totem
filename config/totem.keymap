//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <16 13>;
            layers = <0>;
        };

        combo_excl {
            bindings = <&kp RA(NUMBER_1)>;
            key-positions = <23 24>;
            layers = <1>;
        };

        combo_qmark {
            bindings = <&kp RA(RS(FSLH))>;
            key-positions = <27 28>;
            layers = <1>;
        };

        combo_ralt {
            bindings = <&kp RALT>;
            key-positions = <11 18>;
            layers = <0>;
        };

        combo_enie {
            bindings = <&macro_enie>;
            key-positions = <19 35>;
            layers = <0>;
        };

        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <16 17>;
        };

        combo_num {
            bindings = <&mo 3>;
            key-positions = <23 24>;
            layers = <0>;
        };

        combo_mhint {
            bindings = <&kp LA(LG(X))>;
            key-positions = <34 35>;
        };

        combo_mnormal {
            bindings = <&kp LA(LG(C))>;
            key-positions = <34 36>;
        };

        combo_mgrid {
            bindings = <&kp LA(LG(G))>;
            key-positions = <34 37>;
        };
    };

    behaviors {
        hrm_l: hrm_l {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            hold-trigger-key-positions = <5 6 7 8 9 31 19 30 29 18 17 28 16 27 15 26 37 36 35 34 33 32 10 11 12 13>;
            require-prior-idle-ms = <150>;
        };

        hrm_r: hrm_r {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <0 1 2 3 4 14 20 21 22 23 24 25 32 33 34 35 36 37 10 11 12 13 16 17 18 19>;
            require-prior-idle-ms = <150>;
        };

        thumb_hold_tap: thumb_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_HOLD_TAP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    macros {
        macro_enie: macro_enie {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(N) &kp N>;
            label = "MACRO_ENIE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
               &kp Q          &kp W          &kp E           &kp R            &kp T                          &kp Y      &kp U           &kp I           &kp O          &kp P
               &hrm_l LGUI A  &hrm_l LALT S  &hrm_l LCTRL D  &hrm_l LSHIFT F  &kp G                          &kp H      &hrm_r LSHFT J  &hrm_r LCTRL K  &hrm_r LALT L  &hrm_r LGUI SEMICOLON
&kp LG(SPACE)  &kp Z          &kp X          &kp C           &kp V            &kp B                          &kp N      &kp M           &kp COMMA       &kp DOT        &kp SLASH              &kp RA(E)
                                             &mo 4           &lt 1 TAB        &thumb_hold_tap 2 BACKSPACE    &kp SPACE  &lt 1 RETURN    &lt 5 DELETE
            >;
        };

        sym {
            bindings = <
       &kp EXCL       &kp AT_SIGN       &kp HASH        &kp DOLLAR            &kp PERCENT    &kp CARET          &kp AMPERSAND          &kp ASTERISK     &kp GRAVE          &kp TILDE
       &kp LESS_THAN  &kp LEFT_BRACKET  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp EQUAL      &kp DOUBLE_QUOTES  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp GREATER_THAN
&none  &none          &none             &kp MINUS       &kp UNDERSCORE        &kp PLUS       &kp SQT            &kp COLON              &kp PIPE         &kp BACKSLASH      &kp QMARK         &tog 1
                                        &none           &none                 &none          &none              &none                  &none
            >;
        };

        nav {
            bindings = <
       &none  &none  &none  &none  &none    &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &kp INS
       &none  &none  &none  &none  &none    &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT  &none
&none  &none  &none  &none  &none  &none    &none     &none          &none        &none      &none    &tog 2
                     &none  &none  &none    &none     &none          &none
            >;
        };

        num {
            bindings = <
       &none   &none   &none   &none   &none    &kp KP_MULTIPLY  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_DIVIDE
       &trans  &trans  &trans  &trans  &none    &kp KP_PLUS      &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_SUBTRACT
&none  &none   &none   &none   &none   &none    &kp KP_EQUAL     &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &none            &tog 3
                       &none   &none   &none    &kp KP_N0        &kp KP_DOT       &none
            >;
        };

        dev {
            bindings = <
       &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none                     &kp C_PREV            &kp C_NEXT            &kp C_PLAY_PAUSE  &none
       &none           &none         &none         &none         &none           &kp LS(LC(LG(NUMBER_4)))  &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &kp K_MUTE        &none
&none  &bt BT_CLR_ALL  &none         &none         &none         &bt BT_CLR      &kp LS(LC(LG(NUMBER_3)))  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none             &none  &tog 4
                                     &none         &none         &none           &none                     &none                 &none
            >;
        };

        fun {
            bindings = <
       &kp F1   &kp F2   &kp F3   &kp F4   &kp F5     &none  &none  &none  &none  &none
       &kp F6   &kp F7   &kp F8   &kp F9   &kp F10    &none  &none  &none  &none  &none
&none  &kp F11  &kp F12  &kp F13  &kp F14  &kp F15    &none  &none  &none  &none  &none  &tog 5
                         &none    &none    &none      &none  &none  &none
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
