#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_num {
            bindings = <&mo 2>;
            key-positions = <32 33>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
       &kp Q       &kp W       &kp E         &kp R            &kp T        &kp Y      &kp U        &kp I        &kp O       &kp P
       &mt LGUI A  &mt LALT S  &mt LCTRL D   &mt LSHIFT F     &kp G        &kp H      &mt RSHFT J  &mt RCTRL K  &mt RALT L  &mt RGUI SEMICOLON
&none  &kp Z       &kp X       &kp C         &kp V            &kp B        &kp N      &kp M        &kp COMMA    &kp DOT     &kp FSLH            &kp LA(E)
                               &lt 4 DELETE  &lt 3 BACKSPACE  &lt 1 ESC    &kp SPACE  &kp ENTER    &kp TAB
            >;
        };

        sym {
            bindings = <
                     &kp EXCLAMATION       &kp AT_SIGN       &kp HASH        &kp DOLLAR            &kp PERCENT    &kp CARET          &kp AMPERSAND          &kp ASTERISK     &kp GRAVE          &kp TILDE
                     &kp LESS_THAN         &kp LEFT_BRACKET  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp EQUAL      &kp DOUBLE_QUOTES  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp GREATER_THAN
&kp LA(EXCLAMATION)  &kp NON_US_BACKSLASH  &kp PIPE          &kp MINUS       &kp UNDERSCORE        &kp PLUS       &none              &kp SQT                &none            &none              &kp QUESTION      &kp LS(LA(QUESTION))
                                                             &none           &none                 &none          &trans             &trans                 &trans
            >;
        };

        num {
            bindings = <
       &none  &none  &none   &none   &none     &kp KP_MULTIPLY  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_DIVIDE
       &none  &none  &none   &none   &none     &kp KP_PLUS      &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_SUBTRACT
&none  &none  &none  &none   &none   &none     &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_EQUAL     &none
                     &trans  &trans  &trans    &trans           &trans           &trans
            >;
        };

        nav {
            bindings = <
       &none  &none  &none  &none  &none    &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &kp INS
       &none  &none  &none  &none  &none    &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT  &none
&none  &none  &none  &none  &none  &none    &none     &none          &none        &none      &none    &none
                     &none  &none  &none    &none     &none          &none
            >;
        };

        device {
            bindings = <
       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 0  &kp C_PREV            &kp C_NEXT            &kp C_PLAY_PAUSE  &bt BT_SEL 4
       &none         &none         &none         &none         &none           &none         &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &kp K_MUTE        &none
&none  &none         &none         &none         &none         &none           &none         &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none             &none         &bt BT_CLR
                                   &none         &none         &none           &none         &none                 &none
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        device {
            if-layers = <4 2>;
            then-layer = <6>;
        };
    };
};
