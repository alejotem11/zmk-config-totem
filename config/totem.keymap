//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <16 13>;
            layers = <0>;
        };

        combo_excl {
            bindings = <&kp RA(NUMBER_1)>;
            key-positions = <0 1>;
            layers = <1>;
        };

        combo_qmark {
            bindings = <&kp RA(RS(FSLH))>;
            key-positions = <30 29>;
            layers = <1>;
        };

        combo_ralt {
            bindings = <&kp RALT>;
            key-positions = <11 18>;
            layers = <0>;
        };

        combo_enie {
            bindings = <&macro_enie>;
            key-positions = <18 19>;
            layers = <0>;
        };

        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <16 17>;
        };
    };

    behaviors {
        hrm: hrm {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
        };

        td_prim_left: td_prim_left {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_PRIM_LEFT";
            #binding-cells = <0>;
            bindings = <&lt 2 BACKSPACE>, <&mo 3>;
        };
    };

    macros {
        macro_enie: macro_enie {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(N) &kp N>;
            label = "MACRO_ENIE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
               &kp Q        &kp W        &kp E         &kp R          &kp T            &kp Y      &kp U         &kp I         &kp O        &kp P
               &hrm LGUI A  &hrm LALT S  &hrm LCTRL D  &hrm LSHIFT F  &kp G            &kp H      &hrm RSHFT J  &hrm RCTRL K  &hrm LALT L  &hrm RGUI SEMICOLON
&kp LG(SPACE)  &kp Z        &kp X        &kp C         &kp V          &kp B            &kp N      &kp M         &kp COMMA     &kp DOT      &kp SLASH            &kp RA(E)
                                         &lt 4 TAB     &lt 1 DELETE   &td_prim_left    &kp SPACE  &lt 1 RETURN  &mo 5
            >;
        };

        sym {
            bindings = <
       &kp EXCL       &kp AT_SIGN       &kp HASH        &kp DOLLAR            &kp PERCENT    &kp CARET          &kp AMPERSAND          &kp ASTERISK     &kp GRAVE          &kp TILDE
       &kp LESS_THAN  &kp LEFT_BRACKET  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp EQUAL      &kp DOUBLE_QUOTES  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp GREATER_THAN
&none  &none          &none             &kp MINUS       &kp UNDERSCORE        &kp PLUS       &kp SQT            &kp COLON              &kp PIPE         &kp BACKSLASH      &kp QMARK         &none
                                        &none           &none                 &none          &trans             &trans                 &trans
            >;
        };

        nav {
            bindings = <
       &none  &none  &none  &none  &none    &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &kp INS
       &none  &none  &none  &none  &none    &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT  &none
&none  &none  &none  &none  &none  &none    &none     &kp LC(B)      &none        &none      &none    &none
                     &none  &none  &none    &trans    &trans         &trans
            >;
        };

        num {
            bindings = <
       &none  &none  &none   &none   &none     &kp KP_MULTIPLY  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_DIVIDE
       &none  &none  &none   &none   &none     &kp KP_PLUS      &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_SUBTRACT
&none  &none  &none  &none   &none   &none     &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_EQUAL     &none
                     &trans  &trans  &trans    &trans           &trans           &trans
            >;
        };

        dev {
            bindings = <
       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2              &bt BT_SEL 3              &bt BT_SEL 4    &none  &kp C_PREV            &kp C_NEXT            &kp C_PLAY_PAUSE  &none
       &none         &none         &kp LS(LC(LG(NUMBER_3)))  &kp LS(LC(LG(NUMBER_4)))  &none           &none  &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &kp K_MUTE        &none
&none  &none         &none         &none                     &none                     &none           &none  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none             &none  &none
                                   &none                     &none                     &none           &none  &none                 &none
            >;
        };

        fun {
            bindings = <
       &kp F1   &kp F2   &kp F3   &kp F4   &kp F5     &none  &none  &none  &none  &none
       &kp F6   &kp F7   &kp F8   &kp F9   &kp F10    &none  &none  &none  &none  &none
&none  &kp F11  &kp F12  &kp F13  &kp F14  &kp F15    &none  &none  &none  &none  &none  &none
                         &none    &none    &none      &none  &none  &none
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
